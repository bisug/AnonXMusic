# Keep the build context small and the image free of secrets/dev cruft.
# Applies to Heroku (container stack), Render (Docker), and VPS docker compose.

# --- Secrets / credentials ---
.env
.env.*
*.session
*.session-journal

# --- Runtime data / caches ---
.cache
cache/
downloads/
log.txt
*.log
melody/cookies/*.txt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
# Kept out of the build context: uv then has no version hint and falls back to
# the image's system 3.14, which the Dockerfile pins explicitly anyway.
.python-version

# --- VCS / CI / editors ---
.git
.gitignore
.gitattributes
.github
.idea
.vscode/
.DS_Store
Thumbs.db

# --- Deploy manifests not needed inside the image ---
docker-compose.yml
render.yaml
app.json
heroku.yml
Procfile
.slugignore
setup
sample.env
Dockerfile
.dockerignore

# --- Docs / tests never copied into the image ---
README.md
CHANGELOG.md
docs/
wiki/
tests/
