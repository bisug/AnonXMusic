# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on telegram
BOT_TOKEN=
LOGGER_ID=

# mongo url from cloud.mongodb.com
MONGO_URL=

OWNER_ID=

# pyrogram session from @StringFatherBot on telegram
SESSION=

# support links; use a URL, @username, username, or numeric chat ID
# if you use a private channel/group ID, the bot must be admin with invite link permission
SUPPORT_CHANNEL=https://t.me/SuMelodyVibes
SUPPORT_CHAT=https://t.me/SuMelodyVibes

# YouTube download API fallback (streams the file directly)
# GET {API_URL}/download?url=<id>&type=audio|video&api_key=<key>
API_URL=https://api01.shrutibots.site
API_KEY=

# Second fallback: OneGrab (https://api.onegrab.fun, key from @FallenApiBot /apikey)
# GET /api/track?url=<watch-url> with X-API-Key header -> {cdnurl}
ONEGRAB_URL=https://api.onegrab.fun
ONEGRAB_KEY=

# Third fallback: NexGen (separate audio/video hosts, same key)
# Audio: GET {NEXGEN_AUDIO_URL}/stream/{id}?api=KEY -> direct audio/webm stream
# Video: GET {NEXGEN_VIDEO_URL}/video/{id}?api=KEY -> {status, link} -> link streams file
NEXGEN_AUDIO_URL=https://pvtz.nexgenbots.xyz
NEXGEN_VIDEO_URL=https://api.video.nexgenbots.xyz
NEXGEN_KEY=

# PO token provider server (bgutil-ytdlp-pot-provider), e.g.
#   docker run -d --init brainicism/bgutil-ytdlp-pot-provider
# Leave empty to disable. See anony/core/youtube.py for details.
POT_BASE_URL=
